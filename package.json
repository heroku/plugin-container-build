{
  "name": "@heroku-cli/plugin-container-build",
  "description": "Use this plugin to build and run your app locally as a docker image/container.",
  "version": "0.1.14",
  "author": "Joe Kutner @codefinger",
  "bugs": "https://github.com/heroku/plugin-container-build/issues",
  "dependencies": {
    "@heroku-cli/command": "^8.1.23",
    "@oclif/command": "^1",
    "@oclif/config": "^1",
    "@types/debug": "^0.0.30",
    "@types/shell-escape": "^0.2.0",
    "cli-ux": "^4.6.3",
    "debug": "^3.1.0",
    "execa": "^0.10.0",
    "http-call": "^5.1.4",
    "inquirer": "^6.0.0",
    "node-fetch": "^2.1.2",
    "parse-procfile": "^0.0.2",
    "tmp-promise": "^1.0.5",
    "tslib": "^1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@heroku-cli/schema": "^1.0.5",
    "@oclif/plugin-help": "5.x",
    "@oclif/test": "^1",
    "@types/chai": "^4",
    "@types/execa": "^0.9.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "16.11.7",
    "chai": "^4",
    "eslint": "8.x",
    "eslint-config-oclif": "^5.2.1",
    "eslint-config-oclif-typescript": "^3.1.9",
    "mocha": "^10.4.0",
    "nyc": "^17.0.0",
    "oclif": "^4.14.27",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "/lib",
    "/oclif.manifest.json",
    "/scripts"
  ],
  "homepage": "https://github.com/heroku/plugin-container-build",
  "keywords": [
    "oclif-plugin"
  ],
  "license": "MIT",
  "tatara": {
    "version": "0.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "commands": "./lib/commands",
    "bin": "oclif-example",
    "devPlugins": [
      "@oclif/plugin-help"
    ]
  },
  "repository": "heroku/plugin-container-build",
  "scripts": {
    "postinstall": "node scripts/download.js",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "rm -rf lib && tsc && cp src/*.js lib/ && oclif manifest && oclif readme",
    "prepare": "rm -rf lib && tsc",
    "lint": "eslint . --ext .ts",
    "test": "bash bin/test && nyc mocha --forbid-only \"test/**/*.test.ts\"",
    "posttest": "tslint -p .",
    "version": "oclif readme && git add README.md"
  }
}
